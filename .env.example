# Copy this file to ".env" and fill in your Stripe TEST keys.
# Get them at https://dashboard.stripe.com/test/apikeys  (toggle "Test mode" ON).
#
# IMPORTANT: use TEST keys (they start with sk_test_ / rk_test_ / pk_test_).
# Never put a LIVE key (sk_live_ / pk_live_) in a prototype — it can charge real cards.
# Prefer a RESTRICTED key (rk_test_) with write access limited to: Checkout Sessions.
#
# Put real keys only in ".env" (which is gitignored) — NOT in this .env.example file.
STRIPE_SECRET_KEY=rk_test_xxx_or_sk_test_xxx

# Publishable key (starts with pk_test_). Safe to expose in the browser.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional: webhook signing secret (starts with whsec_).
# Only needed if you run `stripe listen` to test webhooks locally. Leave blank otherwise.
STRIPE_WEBHOOK_SECRET=

# Port the local server runs on.
PORT=4242

# ── Supabase (manager portal: database + email/password auth) ──────────────
# Create a free project at https://supabase.com → then Project Settings → API.
# URL and ANON key are safe in the browser; SERVICE_ROLE key is SECRET (server only).
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...            # public (used by the manager login page)
SUPABASE_SERVICE_ROLE_KEY=eyJ...    # SECRET — server only, never commit / never expose

